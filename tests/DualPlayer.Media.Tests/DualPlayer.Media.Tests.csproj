  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\DualPlayer.Media\DualPlayer.Media.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="TestMedia/**" CopyToOutputDirectory="PreserveNewest" LinkBase="TestMedia" />
  </ItemGroup>
  <ItemGroup>
    <!-- The Core fakes and the session rig: the real PlaybackSession over real FFmpeg on generated samples (AC-09, AC-09b). -->
    <Compile Include="..\DualPlayer.Core.Tests\Fakes\*.cs" Exclude="..\DualPlayer.Core.Tests\Fakes\*Tests.cs" LinkBase="CoreFakes" />
  </ItemGroup>
</Project>
