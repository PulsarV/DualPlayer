<!-- Design tokens for 1080p distance viewing (docs/architecture-map.md §Frontend / UI foundation).
     Sizes are 1080p baselines; scaling by window height and the UI-scale setting is added by roadmap step 8. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Double x:Key="FontSizeMinimum">24</x:Double>
  <x:Double x:Key="FontSizeBody">32</x:Double>
  <x:Double x:Key="FontSizeHeading">48</x:Double>
  <x:Double x:Key="ButtonMinSize">96</x:Double>
  <Thickness x:Key="FocusBorderThickness">4</Thickness>

  <!-- Contrast >= 7:1 between foreground and surface. -->
  <Color x:Key="SurfaceColor">#FF000000</Color>
  <Color x:Key="ForegroundColor">#FFFFFFFF</Color>
  <Color x:Key="FocusColor">#FFFFD400</Color>
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="ForegroundBrush" Color="{StaticResource ForegroundColor}" />
  <SolidColorBrush x:Key="FocusBrush" Color="{StaticResource FocusColor}" />
</ResourceDictionary>
